  "algo: debug": {
    "scope": "cpp",
    "prefix": "algo-debug",
    "body": [
      "// Container-aware debug printing, identical to the block inside template.cpp.",
      "// Only active with -D_UTSAV_, so debug() lines are safe to leave in what you",
      "// submit. Every line starts with \"[dbg \" so tools/check.sh can strip them",
      "// before comparing output.txt with expected_output.txt.",
      "",
      "#ifdef _UTSAV_",
      "",
      "namespace dbgx {",
      "",
      "template <class T, class = void>",
      "struct is_iterable : std::false_type {};",
      "template <class T>",
      "struct is_iterable<T, std::void_t<decltype(std::begin(std::declval<const T&>())),",
      "                                  decltype(std::end(std::declval<const T&>()))>>",
      "    : std::true_type {};",
      "",
      "template <class T>",
      "void pr(const T& x) {",
      "    if constexpr (std::is_convertible_v<T, std::string_view>) {",
      "        std::cerr << '\"' << std::string_view(x) << '\"';",
      "    } else if constexpr (std::is_same_v<T, char>) {",
      "        std::cerr << '\\\\'' << x << '\\\\'';",
      "    } else if constexpr (std::is_same_v<T, bool>) {",
      "        std::cerr << (x ? \"true\" : \"false\");",
      "    } else if constexpr (requires { x.first; x.second; }) {",
      "        std::cerr << '(';",
      "        pr(x.first);",
      "        std::cerr << \", \";",
      "        pr(x.second);",
      "        std::cerr << ')';",
      "    } else if constexpr (is_iterable<T>::value) {",
      "        std::cerr << '{';",
      "        bool first = true;",
      "        for (const auto& e : x) {",
      "            if (!first) std::cerr << \", \";",
      "            first = false;",
      "            pr(e);",
      "        }",
      "        std::cerr << '}';",
      "    } else if constexpr (requires { std::tuple_size<T>::value; }) {",
      "        std::cerr << '(';",
      "        bool first = true;",
      "        std::apply([&](const auto&... a) { ((std::cerr << (first ? \"\" : \", \"), first = false, pr(a)), ...); }, x);",
      "        std::cerr << ')';",
      "    } else {",
      "        std::cerr << x;",
      "    }",
      "}",
      "",
      "inline void pr_all() {}",
      "template <class T, class... R>",
      "void pr_all(const T& x, const R&... rest) {",
      "    pr(x);",
      "    if constexpr (sizeof...(rest) > 0) {",
      "        std::cerr << \", \";",
      "        pr_all(rest...);",
      "    }",
      "}",
      "",
      "}  // namespace dbgx",
      "",
      "#ifdef USE_FILES",
      "#define DBG_ON \"\"",
      "#define DBG_OFF \"\"",
      "#else",
      "#define DBG_ON \"\\\\033[33m\"",
      "#define DBG_OFF \"\\\\033[0m\"",
      "#endif",
      "",
      "#define debug(...)                                                                     \\\\",
      "    (std::cerr << DBG_ON \"[dbg L\" << __LINE__ << \"] \" << #__VA_ARGS__ << \" = \" DBG_OFF, \\\\",
      "     dbgx::pr_all(__VA_ARGS__), std::cerr << std::endl)",
      "",
      "#else",
      "#define debug(...) ((void)0)",
      "#endif"
    ],
    "description": "Container-aware debug printing, identical to the block inside template.cpp."
  },
  "algo: dsu": {
    "scope": "cpp",
    "prefix": "algo-dsu",
    "body": [
      "// Disjoint set union with union by size + path compression. O(alpha(n)) amortized.",
      "struct DSU {",
      "    std::vector<int> p, sz;",
      "    int comps;",
      "",
      "    explicit DSU(int n) : p(n), sz(n, 1), comps(n) {",
      "        std::iota(p.begin(), p.end(), 0);",
      "    }",
      "",
      "    int find(int x) {",
      "        while (p[x] != x) x = p[x] = p[p[x]];",
      "        return x;",
      "    }",
      "",
      "    bool same(int a, int b) { return find(a) == find(b); }",
      "",
      "    // returns false if a and b were already in the same component",
      "    bool unite(int a, int b) {",
      "        a = find(a), b = find(b);",
      "        if (a == b) return false;",
      "        if (sz[a] < sz[b]) std::swap(a, b);",
      "        p[b] = a;",
      "        sz[a] += sz[b];",
      "        --comps;",
      "        return true;",
      "    }",
      "",
      "    int size(int x) { return sz[find(x)]; }",
      "};"
    ],
    "description": "Disjoint set union with union by size + path compression. O(alpha(n)) amortized."
  },
  "algo: fenwick": {
    "scope": "cpp",
    "prefix": "algo-fenwick",
    "body": [
      "// Fenwick (binary indexed) tree, 0-indexed interface. Point add, prefix sum.",
      "template <class T = long long>",
      "struct Fenwick {",
      "    int n;",
      "    std::vector<T> t;",
      "",
      "    explicit Fenwick(int n_) : n(n_), t(n_ + 1, T{}) {}",
      "",
      "    void add(int i, T v) {",
      "        for (++i; i <= n; i += i & -i) t[i] += v;",
      "    }",
      "",
      "    // sum of [0, r)",
      "    T sum(int r) const {",
      "        T s{};",
      "        for (; r > 0; r -= r & -r) s += t[r];",
      "        return s;",
      "    }",
      "",
      "    // sum of [l, r)",
      "    T sum(int l, int r) const { return sum(r) - sum(l); }",
      "",
      "    // smallest i such that sum(i + 1) > target; -1 if none. Requires non-negative values.",
      "    int lower_bound(T target) const {",
      "        int pos = 0;",
      "        T cur{};",
      "        for (int pw = 1 << std::__lg(std::max(n, 1)); pw > 0; pw >>= 1) {",
      "            if (pos + pw <= n && cur + t[pos + pw] <= target) {",
      "                pos += pw;",
      "                cur += t[pos];",
      "            }",
      "        }",
      "        return pos == n ? -1 : pos;",
      "    }",
      "};"
    ],
    "description": "Fenwick (binary indexed) tree, 0-indexed interface. Point add, prefix sum."
  },
  "algo: graph": {
    "scope": "cpp",
    "prefix": "algo-graph",
    "body": [
      "namespace graph {",
      "",
      "constexpr long long LINF = 4e18;",
      "",
      "using WGraph = std::vector<std::vector<std::pair<int, long long>>>;  // {to, weight}",
      "",
      "// Dijkstra from src. Returns distances; unreachable nodes get LINF.",
      "// Pass a non-null parent vector to recover paths.",
      "inline std::vector<long long> dijkstra(const WGraph& g, int src,",
      "                                       std::vector<int>* parent = nullptr) {",
      "    int n = (int)g.size();",
      "    std::vector<long long> dist(n, LINF);",
      "    if (parent) parent->assign(n, -1);",
      "    std::priority_queue<std::pair<long long, int>, std::vector<std::pair<long long, int>>,",
      "                        std::greater<>>",
      "        pq;",
      "    dist[src] = 0;",
      "    pq.emplace(0LL, src);",
      "    while (!pq.empty()) {",
      "        auto [d, u] = pq.top();",
      "        pq.pop();",
      "        if (d != dist[u]) continue;",
      "        for (auto [v, w] : g[u]) {",
      "            if (d + w < dist[v]) {",
      "                dist[v] = d + w;",
      "                if (parent) (*parent)[v] = u;",
      "                pq.emplace(dist[v], v);",
      "            }",
      "        }",
      "    }",
      "    return dist;",
      "}",
      "",
      "// Unweighted shortest paths. Unreachable nodes get -1.",
      "inline std::vector<int> bfs(const std::vector<std::vector<int>>& g, int src) {",
      "    std::vector<int> dist((int)g.size(), -1);",
      "    std::queue<int> q;",
      "    dist[src] = 0;",
      "    q.push(src);",
      "    while (!q.empty()) {",
      "        int u = q.front();",
      "        q.pop();",
      "        for (int v : g[u])",
      "            if (dist[v] == -1) {",
      "                dist[v] = dist[u] + 1;",
      "                q.push(v);",
      "            }",
      "    }",
      "    return dist;",
      "}",
      "",
      "// Topological order of a DAG; empty vector if the graph has a cycle.",
      "inline std::vector<int> topo_sort(const std::vector<std::vector<int>>& g) {",
      "    int n = (int)g.size();",
      "    std::vector<int> indeg(n, 0), order;",
      "    for (int u = 0; u < n; ++u)",
      "        for (int v : g[u]) ++indeg[v];",
      "    std::queue<int> q;",
      "    for (int u = 0; u < n; ++u)",
      "        if (indeg[u] == 0) q.push(u);",
      "    while (!q.empty()) {",
      "        int u = q.front();",
      "        q.pop();",
      "        order.push_back(u);",
      "        for (int v : g[u])",
      "            if (--indeg[v] == 0) q.push(v);",
      "    }",
      "    if ((int)order.size() != n) order.clear();",
      "    return order;",
      "}",
      "",
      "}  // namespace graph"
    ],
    "description": "Dijkstra from src. Returns distances; unreachable nodes get LINF."
  },
  "algo: math": {
    "scope": "cpp",
    "prefix": "algo-math",
    "body": [
      "namespace nt {",
      "",
      "// (base^e) % mod, safe for mod < 2^31",
      "inline long long pw(long long b, long long e, long long mod) {",
      "    long long r = 1 % mod;",
      "    b %= mod;",
      "    if (b < 0) b += mod;",
      "    while (e > 0) {",
      "        if (e & 1) r = (__int128)r * b % mod;",
      "        b = (__int128)b * b % mod;",
      "        e >>= 1;",
      "    }",
      "    return r;",
      "}",
      "",
      "// Linear sieve: smallest prime factor for every i <= n, plus the prime list.",
      "struct Sieve {",
      "    std::vector<int> spf, primes;",
      "",
      "    explicit Sieve(int n) : spf(n + 1, 0) {",
      "        for (int i = 2; i <= n; ++i) {",
      "            if (spf[i] == 0) {",
      "                spf[i] = i;",
      "                primes.push_back(i);",
      "            }",
      "            for (int p : primes) {",
      "                if (p > spf[i] || (long long)i * p > n) break;",
      "                spf[(long long)i * p] = p;",
      "            }",
      "        }",
      "    }",
      "",
      "    bool is_prime(int x) const { return x >= 2 && spf[x] == x; }",
      "",
      "    // prime -> exponent, using the precomputed spf table",
      "    std::vector<std::pair<int, int>> factor(int x) const {",
      "        std::vector<std::pair<int, int>> f;",
      "        while (x > 1) {",
      "            int p = spf[x], c = 0;",
      "            while (x % p == 0) x /= p, ++c;",
      "            f.emplace_back(p, c);",
      "        }",
      "        return f;",
      "    }",
      "};",
      "",
      "// Trial division for a single number up to ~1e18 when no sieve is available.",
      "inline std::vector<std::pair<long long, int>> factor(long long x) {",
      "    std::vector<std::pair<long long, int>> f;",
      "    for (long long p = 2; p * p <= x; ++p) {",
      "        if (x % p) continue;",
      "        int c = 0;",
      "        while (x % p == 0) x /= p, ++c;",
      "        f.emplace_back(p, c);",
      "    }",
      "    if (x > 1) f.emplace_back(x, 1);",
      "    return f;",
      "}",
      "",
      "// extended gcd: returns g = gcd(a, b) with a*x + b*y = g",
      "inline long long extgcd(long long a, long long b, long long& x, long long& y) {",
      "    if (b == 0) { x = 1, y = 0; return a; }",
      "    long long x1, y1;",
      "    long long g = extgcd(b, a % b, x1, y1);",
      "    x = y1;",
      "    y = x1 - (a / b) * y1;",
      "    return g;",
      "}",
      "",
      "// modular inverse for any mod coprime to a; returns -1 when it does not exist",
      "inline long long inv_mod(long long a, long long mod) {",
      "    long long x, y;",
      "    long long g = extgcd(((a % mod) + mod) % mod, mod, x, y);",
      "    if (g != 1) return -1;",
      "    return ((x % mod) + mod) % mod;",
      "}",
      "",
      "}  // namespace nt"
    ],
    "description": "(base^e) % mod, safe for mod < 2^31"
  },
  "algo: modint": {
    "scope": "cpp",
    "prefix": "algo-modint",
    "body": [
      "// Compile-time modulus modular integer. MOD must be prime for inv()/operator/.",
      "template <unsigned MOD>",
      "struct ModInt {",
      "    unsigned v;",
      "",
      "    constexpr ModInt(long long x = 0) : v(0) {",
      "        long long r = x % (long long)MOD;",
      "        if (r < 0) r += MOD;",
      "        v = (unsigned)r;",
      "    }",
      "",
      "    static constexpr unsigned mod() { return MOD; }",
      "",
      "    ModInt& operator+=(const ModInt& o) { if ((v += o.v) >= MOD) v -= MOD; return *this; }",
      "    ModInt& operator-=(const ModInt& o) { if ((v += MOD - o.v) >= MOD) v -= MOD; return *this; }",
      "    ModInt& operator*=(const ModInt& o) { v = (unsigned)((unsigned long long)v * o.v % MOD); return *this; }",
      "    ModInt& operator/=(const ModInt& o) { return *this *= o.inv(); }",
      "",
      "    friend ModInt operator+(ModInt a, const ModInt& b) { return a += b; }",
      "    friend ModInt operator-(ModInt a, const ModInt& b) { return a -= b; }",
      "    friend ModInt operator*(ModInt a, const ModInt& b) { return a *= b; }",
      "    friend ModInt operator/(ModInt a, const ModInt& b) { return a /= b; }",
      "    ModInt operator-() const { return ModInt() - *this; }",
      "",
      "    friend bool operator==(const ModInt& a, const ModInt& b) { return a.v == b.v; }",
      "    friend bool operator!=(const ModInt& a, const ModInt& b) { return a.v != b.v; }",
      "",
      "    ModInt pow(long long e) const {",
      "        ModInt b = *this, r = 1;",
      "        if (e < 0) { b = b.inv(); e = -e; }",
      "        while (e) { if (e & 1) r *= b; b *= b; e >>= 1; }",
      "        return r;",
      "    }",
      "",
      "    ModInt inv() const { return pow((long long)MOD - 2); }",
      "",
      "    friend std::ostream& operator<<(std::ostream& os, const ModInt& a) { return os << a.v; }",
      "    friend std::istream& operator>>(std::istream& is, ModInt& a) { long long x; is >> x; a = ModInt(x); return is; }",
      "};",
      "",
      "using mint = ModInt<998244353>;",
      "// using mint = ModInt<1000000007>;",
      "",
      "// Factorials / binomials. Call Comb::init(n) once before use.",
      "namespace Comb {",
      "inline std::vector<mint> fact, inv_fact;",
      "",
      "inline void init(int n) {",
      "    fact.assign(n + 1, 1);",
      "    inv_fact.assign(n + 1, 1);",
      "    for (int i = 1; i <= n; ++i) fact[i] = fact[i - 1] * i;",
      "    inv_fact[n] = fact[n].inv();",
      "    for (int i = n; i > 0; --i) inv_fact[i - 1] = inv_fact[i] * i;",
      "}",
      "",
      "inline mint C(int n, int k) {",
      "    if (k < 0 || k > n || n < 0) return 0;",
      "    return fact[n] * inv_fact[k] * inv_fact[n - k];",
      "}",
      "",
      "inline mint P(int n, int k) {",
      "    if (k < 0 || k > n || n < 0) return 0;",
      "    return fact[n] * inv_fact[n - k];",
      "}",
      "}  // namespace Comb"
    ],
    "description": "Compile-time modulus modular integer. MOD must be prime for inv()/operator/."
  },
  "algo: segtree": {
    "scope": "cpp",
    "prefix": "algo-segtree",
    "body": [
      "// Iterative segment tree over any monoid (op, identity). Non-commutative safe.",
      "// Usage:",
      "//   SegTree st(n, 0LL, [](long long a, long long b) { return a + b; });",
      "//   st.build(values);  st.set(i, v);  st.query(l, r);   // half-open [l, r)",
      "template <class T, class Op>",
      "struct SegTree {",
      "    int n;",
      "    T id;",
      "    Op op;",
      "    std::vector<T> t;",
      "",
      "    SegTree(int n_, T id_, Op op_) : n(n_), id(id_), op(op_), t(2 * n_, id_) {}",
      "",
      "    void build(const std::vector<T>& a) {",
      "        for (int i = 0; i < n; ++i) t[n + i] = a[i];",
      "        for (int i = n - 1; i > 0; --i) t[i] = op(t[2 * i], t[2 * i + 1]);",
      "    }",
      "",
      "    void set(int i, T v) {",
      "        for (t[i += n] = v; i > 1; i >>= 1) t[i >> 1] = op(t[i & ~1], t[i | 1]);",
      "    }",
      "",
      "    T get(int i) const { return t[i + n]; }",
      "",
      "    // fold over [l, r)",
      "    T query(int l, int r) const {",
      "        T resl = id, resr = id;",
      "        for (l += n, r += n; l < r; l >>= 1, r >>= 1) {",
      "            if (l & 1) resl = op(resl, t[l++]);",
      "            if (r & 1) resr = op(t[--r], resr);",
      "        }",
      "        return op(resl, resr);",
      "    }",
      "};",
      "",
      "template <class T, class Op>",
      "SegTree(int, T, Op) -> SegTree<T, Op>;"
    ],
    "description": "Iterative segment tree over any monoid (op, identity). Non-commutative safe."
  },
  "algo: strings": {
    "scope": "cpp",
    "prefix": "algo-strings",
    "body": [
      "namespace str {",
      "",
      "// z[i] = length of the longest common prefix of s and s.substr(i). z[0] = n.",
      "inline std::vector<int> z_function(const std::string& s) {",
      "    int n = (int)s.size();",
      "    std::vector<int> z(n);",
      "    if (n) z[0] = n;",
      "    for (int i = 1, l = 0, r = 0; i < n; ++i) {",
      "        if (i < r) z[i] = std::min(r - i, z[i - l]);",
      "        while (i + z[i] < n && s[z[i]] == s[i + z[i]]) ++z[i];",
      "        if (i + z[i] > r) l = i, r = i + z[i];",
      "    }",
      "    return z;",
      "}",
      "",
      "// pi[i] = length of the longest proper prefix of s[0..i] that is also a suffix.",
      "inline std::vector<int> prefix_function(const std::string& s) {",
      "    int n = (int)s.size();",
      "    std::vector<int> pi(n);",
      "    for (int i = 1; i < n; ++i) {",
      "        int j = pi[i - 1];",
      "        while (j > 0 && s[i] != s[j]) j = pi[j - 1];",
      "        if (s[i] == s[j]) ++j;",
      "        pi[i] = j;",
      "    }",
      "    return pi;",
      "}",
      "",
      "// all start positions of pat inside txt",
      "inline std::vector<int> find_all(const std::string& txt, const std::string& pat) {",
      "    std::vector<int> res;",
      "    if (pat.empty() || pat.size() > txt.size()) return res;",
      "    std::string s = pat + '\\\\1' + txt;",
      "    std::vector<int> z = z_function(s);",
      "    int m = (int)pat.size();",
      "    for (int i = m + 1; i < (int)s.size(); ++i)",
      "        if (z[i] >= m) res.push_back(i - m - 1);",
      "    return res;",
      "}",
      "",
      "// Double polynomial hash. Collision-resistant enough for contest use.",
      "struct Hash {",
      "    static constexpr unsigned long long M1 = 1000000007ULL, M2 = 998244353ULL;",
      "    static constexpr unsigned long long B1 = 131ULL, B2 = 137ULL;",
      "    std::vector<unsigned long long> h1, h2, p1, p2;",
      "",
      "    explicit Hash(const std::string& s) {",
      "        int n = (int)s.size();",
      "        h1.assign(n + 1, 0); h2.assign(n + 1, 0);",
      "        p1.assign(n + 1, 1); p2.assign(n + 1, 1);",
      "        for (int i = 0; i < n; ++i) {",
      "            h1[i + 1] = (h1[i] * B1 + (unsigned char)s[i]) % M1;",
      "            h2[i + 1] = (h2[i] * B2 + (unsigned char)s[i]) % M2;",
      "            p1[i + 1] = p1[i] * B1 % M1;",
      "            p2[i + 1] = p2[i] * B2 % M2;",
      "        }",
      "    }",
      "",
      "    // hash of [l, r)",
      "    std::pair<unsigned long long, unsigned long long> get(int l, int r) const {",
      "        unsigned long long a = (h1[r] + M1 * M1 - h1[l] * p1[r - l]) % M1;",
      "        unsigned long long b = (h2[r] + M2 * M2 - h2[l] * p2[r - l]) % M2;",
      "        return {a, b};",
      "    }",
      "};",
      "",
      "}  // namespace str"
    ],
    "description": "z[i] = length of the longest common prefix of s and s.substr(i). z[0] = n."
  },
  "algo: template": {
    "scope": "cpp",
    "prefix": "algo-template",
    "body": [
      "// TEMPLATE_V2 -- setup.sh looks for this marker to spot working files copied",
      "// from an older template. Bump it if you change the template substantially.",
      "#include <bits/stdc++.h>",
      "using namespace std;",
      "",
      "// ===================== debug =====================",
      "// Everything here disappears unless -D_UTSAV_ is passed, so debug() lines are",
      "// safe to leave in the code you submit.",
      "#ifdef _UTSAV_",
      "",
      "namespace dbgx {",
      "",
      "template <class T, class = void>",
      "struct is_iterable : false_type {};",
      "template <class T>",
      "struct is_iterable<T, void_t<decltype(begin(declval<const T&>())), decltype(end(declval<const T&>()))>>",
      "    : true_type {};",
      "",
      "template <class T>",
      "void pr(const T& x) {",
      "    if constexpr (is_convertible_v<T, string_view>) {",
      "        cerr << '\"' << string_view(x) << '\"';",
      "    } else if constexpr (is_same_v<T, char>) {",
      "        cerr << '\\\\'' << x << '\\\\'';",
      "    } else if constexpr (is_same_v<T, bool>) {",
      "        cerr << (x ? \"true\" : \"false\");",
      "    } else if constexpr (requires { x.first; x.second; }) {",
      "        cerr << '(';",
      "        pr(x.first);",
      "        cerr << \", \";",
      "        pr(x.second);",
      "        cerr << ')';",
      "    } else if constexpr (is_iterable<T>::value) {",
      "        cerr << '{';",
      "        bool first = true;",
      "        for (const auto& e : x) {",
      "            if (!first) cerr << \", \";",
      "            first = false;",
      "            pr(e);",
      "        }",
      "        cerr << '}';",
      "    } else if constexpr (requires { tuple_size<T>::value; }) {",
      "        cerr << '(';",
      "        bool first = true;",
      "        apply([&](const auto&... a) { ((cerr << (first ? \"\" : \", \"), first = false, pr(a)), ...); }, x);",
      "        cerr << ')';",
      "    } else {",
      "        cerr << x;",
      "    }",
      "}",
      "",
      "inline void pr_all() {}",
      "template <class T, class... R>",
      "void pr_all(const T& x, const R&... rest) {",
      "    pr(x);",
      "    if constexpr (sizeof...(rest) > 0) {",
      "        cerr << \", \";",
      "        pr_all(rest...);",
      "    }",
      "}",
      "",
      "}  // namespace dbgx",
